# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_API_TOKEN=

# Application / Client ID from the Developer Portal
DISCORD_API_CLIENT=

# ── Genius API ────────────────────────────────────────────────────────────────
# API key from https://genius.com/api-clients
GENIUS_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use a local SQLite file (docker-compose sets this automatically).
# Set to your Turso DB URL for cloud hosting, e.g. libsql://your-db.turso.io
TURSO_DATABASE_URL=

# Required only when using Turso cloud (leave blank for local SQLite)
TURSO_AUTH_TOKEN=
